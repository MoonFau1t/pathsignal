BRAVE_API_KEY=your_brave_api_key_here
AGENTWORKFLOW_DB_PATH=data/agentworkflow.db
SEARCH_API_MAX_PLANS=5
SEARCH_API_PLAN_OFFSET=0
SEARCH_API_TIMEOUT_SECONDS=20
SEARCH_API_DRY_RUN=true

RSS_DRY_RUN=true
RSS_MAX_FEEDS=5
RSS_MAX_ITEMS_PER_FEED=5

SELECTED_WEBSITE_DRY_RUN=true
SELECTED_WEBSITE_MAX_SITES=5
SELECTED_WEBSITE_MAX_ITEMS_PER_SITE=5

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
AI_FILTER_MODEL=deepseek-v4-pro
TARGET_CAREER_PATH_MODEL=deepseek-v4-pro
SOURCE_MONITORING_PHASE0_ENABLED=false
INFORMATION_NEED_MODEL=deepseek-v4-pro
INFORMATION_NEED_TEMPERATURE=0.2
INFORMATION_NEED_MAX_PER_PATH_OBJECTIVE=4
INFORMATION_NEED_MAX_TOTAL=120
INFORMATION_NEED_MAX_SIGNAL_EXAMPLES=5
INFORMATION_NEED_CACHE_ENABLED=true
SOURCE_MONITORING_PHASE1_ENABLED=false
ENTITY_TYPE_EXPANSION_MODEL=deepseek-v4-pro
ENTITY_TYPE_EXPANSION_TEMPERATURE=0.2
ENTITY_TYPE_EXPANSION_MAX_CANONICAL_CANDIDATES=25
ENTITY_TYPE_EXPANSION_MAX_PROPOSED_TYPES=5
ENTITY_TYPE_EXPANSION_MAX_TYPES_PER_NEED=5
ENTITY_TYPE_EXPANSION_MAX_DISCOVERY_TERMS=8
ENTITY_TYPE_EXPANSION_CACHE_ENABLED=true
SOURCE_MONITORING_PHASE2_ENABLED=false
ENTITY_DISCOVERY_MAX_PLANS=24
ENTITY_DISCOVERY_RESULTS_PER_PLAN=5
ENTITY_DISCOVERY_LANGUAGES=en,zh
ENTITY_DISCOVERY_REGIONS=global,china
ENTITY_DISCOVERY_MAX_ENTITIES_PER_TYPE=5
ENTITY_DISCOVERY_EXTRACTION_MAX_EVIDENCE_PER_BATCH=60
ENTITY_DISCOVERY_MAX_QUERIES_PER_TYPE=4
ENTITY_DISCOVERY_PLANNING_MODEL=deepseek-v4-pro
ENTITY_DISCOVERY_PLANNING_TEMPERATURE=0.2
ENTITY_DISCOVERY_EXTRACTION_MODEL=deepseek-v4-pro
ENTITY_DISCOVERY_EXTRACTION_TEMPERATURE=0.1
ENTITY_DISCOVERY_CACHE_ENABLED=true
SOURCE_MONITORING_PHASE3_ENABLED=false
ENTITY_PRIORITIZATION_MODEL=deepseek-v4-pro
ENTITY_PRIORITIZATION_TEMPERATURE=0.1
ENTITY_PRIORITIZATION_BATCH_SIZE=40
ENTITY_PRIORITIZATION_MAX_EVIDENCE_PER_ENTITY=4
ENTITY_PRIORITIZATION_CACHE_ENABLED=true
ENTITY_PRIORITY_TIER_A_LIMIT=18
ENTITY_PRIORITY_TIER_B_LIMIT=24
ENTITY_PRIORITY_TIER_C_LIMIT=18
SOURCE_INSPECTION_MAX_CANDIDATES=20
USER_PROFILE_EXTRACTION_MODEL=deepseek-v4-pro
AI_FILTER_DRY_RUN=true
